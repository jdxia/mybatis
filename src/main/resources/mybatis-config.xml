<configuration>
    <settings>
<!--        <setting name="logImpl" value="LOG4J"/>-->
        <setting name="logImpl" value="SLF4J"/>
<!--        <setting name="logImpl" value="STDOUT_LOGGING"/>-->

        <!-- 禁用日志输出 -->
<!--        <setting name="logImpl" value="NO_LOGGING"/>-->
    </settings>

<!--    <typeAliases>-->
